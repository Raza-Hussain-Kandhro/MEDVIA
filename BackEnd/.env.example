PORT=8000
# Connection string WITHOUT a database name, for example mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
# Database name. Set to BIOVA_SURGICALS if you already have data stored under the old name.
MONGO_DB_NAME=MEDVIA
# Comma-separated allowed origins. A leading "*." allows any subdomain (for example *.vercel.app for previews).
CORS_ORIGINS=http://localhost:5173
# Set by the deploy pipeline; returned by /api/health.
COMMIT_SHA=
